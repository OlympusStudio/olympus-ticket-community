# =============================================
# Configuracao do bot de tickets
# =============================================
# Copie este arquivo como ".env" e preencha os valores.

# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID do seu servidor Discord
GUILD_ID=

# Cor padrao dos embeds em hexadecimal
COLOR=#5865F2

# Caminho do banco SQLite
DATABASE_PATH=./data/tickets.sqlite

# ID do canal onde os logs de tickets serao enviados
LOG_CHANNEL_ID=

# ID do canal de avaliacoes
AVALIACAO_CHANNEL_ID=

# ID do canal de sugestoes
SUGESTAO_CHANNEL_ID=

# ID do canal de duvidas
DUVIDA_CHANNEL_ID=

# ID da categoria onde os tickets serao criados
CATEGORY_ID=

# ID do cargo de suporte (quem pode ver os tickets)
SUPPORT_ROLE_ID=

# ID do cargo de cliente (necessario para abrir ticket de avaliacao)
CLIENT_ROLE_ID=
